import { useEffect, useState } from 'react'
import { supabase } from './supabaseClient'

export default function AdminPanel() {
  const [models, setModels] = useState([])
  const [loading, setLoading] = useState(true)

  useEffect(() => {
    fetchModels()
  }, [])

  const fetchModels = async () => {
    setLoading(true)
    const { data, error } = await supabase.from('models').select('*').order('created_at', { ascending: false })
    if (!error) setModels(data)
    setLoading(false)
  }

  const deleteModel = async (id) => {
    const confirmDelete = window.confirm('Supprimer ce fichier definitivement ?')
    if (!confirmDelete) return
    const { error } = await supabase.from('models').delete().eq('id', id)
    if (!error) {
      setModels(models.filter((m) => m.id !== id))
    }
  }

  if (loading) return <p>Chargement...</p>

  return (
    <div style={{ padding: '20px' }}>
      <h1>Panel Admin</h1>
      <p>Liste des fichiers publies sur le site</p>
      {models.map((model) => (
        <div key={model.id} style={{ border: '1px solid #ccc', padding: '10px', marginBottom: '10px' }}>
          <h3>{model.title}</h3>
          <p>{model.description}</p>
          {model.image_url && <img src={model.image_url} alt={model.title} style={{ maxWidth: '150px' }} />}
          <br />
          <button onClick={() => deleteModel(model.id)} style={{ marginTop: '10px', background: 'red', color: 'white', border: 'none', padding: '8px 12px', borderRadius: '5px' }}>
            Supprimer
          </button>
        </div>
      ))}
    </div>
  )
}
